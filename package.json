{
  "name": "@topflight/bot",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "description": "Run a bot on TopFlight: native Ledger trading, your own key, your own gas.",
  "bin": {
    "topflight-bot": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./abis": "./dist/ledger.js",
    "./abi/*": "./abi/*"
  },
  "files": [
    "dist",
    "abi",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
